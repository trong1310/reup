{
  "name": "ai-video-dubber-desktop",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1 --strictPort --port 5173\" \"wait-on tcp:127.0.0.1:5173 && electron electron/main.cjs\"",
    "build": "vite build",
    "start": "electron electron/main.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "5.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "wait-on": "^8.0.3"
  }
}
